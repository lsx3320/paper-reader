# ------------------------------------------------------------------
# 本地小模型方案（这台 8GB M3 的最优解）
#   Ollama(Metal) + Qwen3-1.7B Q4_K_M：模型 1.03GB，常驻内存约 1.9GB
#   启动服务：nohup ./scripts/serve_local_llm.sh > /tmp/local-llm.log 2>&1 &
# ------------------------------------------------------------------
HOST_PORT=8010

LLM_API_KEY=local-no-key-needed
# 容器内访问宿主机上的 Ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3-1.7b-zh
# 小模型要低温度才稳定（云端大模型可用 1.3）
LLM_TEMPERATURE=0.3
# 单槽位本地服务 → 并发必须为 1，否则请求排队反而更慢
LLM_CONCURRENCY=1
LLM_TIMEOUT=600
LLM_RETRIES=2
# 关掉 Qwen3 思考链，否则每段先吐几百 token 推理
LLM_NO_THINK=1
# 0 = 不限，交给 Modelfile 的 num_predict(1024)
LLM_MAX_TOKENS=0

# 术语表全量注入 → system 前缀整篇一致 → 命中前缀 KV 缓存，第二段起预填充≈0
GLOSSARY_ENABLED=1
GLOSSARY_MODE=all

LLM_MOCK=0
LLM_MOCK_DELAY=0.25
TRANSLATE_MAX_CHARS=1800
TRANSLATE_REFS=0
MAX_UPLOAD_MB=80
DATA_DIR=./data
TZ=Asia/Shanghai
