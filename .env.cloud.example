# ------------------------------------------------------------------
# 云端大模型方案（DeepSeek）：质量更好、不占本地内存，按 token 计费
#   cp .env.cloud.example .env && docker compose up -d --force-recreate
# ------------------------------------------------------------------
HOST_PORT=8010
LLM_API_KEY=sk-在这里填你的Key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=1.3
LLM_CONCURRENCY=6
LLM_TIMEOUT=120
LLM_RETRIES=2
LLM_NO_THINK=0
LLM_MAX_TOKENS=0
GLOSSARY_ENABLED=1
GLOSSARY_MODE=match
LLM_MOCK=0
TRANSLATE_MAX_CHARS=1800
TRANSLATE_REFS=0
MAX_UPLOAD_MB=80
DATA_DIR=./data
TZ=Asia/Shanghai

# 论文发现：书库页顶部推荐论文（模型推荐 + 中文概括 + 原文链接，不含下载）
# 走上面那套 LLM_API_KEY，不需要额外配置；关掉就填 0
PICK_ENABLED=1
PICK_BATCH=3
PICK_TEMPERATURE=0.9
PICK_POOL_MIN=3
PICK_POOL_MAX=8
PICK_REFRESH_SEC=1800

# ------------------------------------------------------------------ 语音合成（小米 MiMo TTS）
# ⚠️「限时免费」≠「零余额可用」：mimo-v2.5-tts 单价 ¥0，但账户余额 ≤ 0 时
#    网关会在模型计价前拦掉一切推理（含免费模型），返回 HTTP 402
#    Insufficient account balance，表现为朗读全挂、data/tts/ 始终为空。
#    处理：mimo.mi.com → 账户余额 → 领取免费额度或充值任意金额。
#    自查：curl -s http://127.0.0.1:8010/api/tts/probe
TTS_API_KEY=
TTS_BASE_URL=https://api.xiaomimimo.com/v1
TTS_MODEL=mimo-v2.5-tts
TTS_VOICE=mimo_default
TTS_FORMAT=mp3
TTS_TIMEOUT=180
# 账户级故障后的熔断冷却秒数；设 0 关闭熔断
TTS_FATAL_COOLDOWN=120

