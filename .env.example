# ------------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# ------------------------------------------------------------------

# 对外端口
HOST_PORT=8000

# ------------------------------------------------------------------ 模型
# 任意 OpenAI 兼容接口均可：DeepSeek / OpenAI / Kimi / 硅基流动 / Ollama / vLLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 翻译任务建议用较高温度（DeepSeek 官方推荐 1.3）
LLM_TEMPERATURE=1.3
# 并发请求数：段落级并发，过高可能触发限流
LLM_CONCURRENCY=6
LLM_TIMEOUT=120
LLM_RETRIES=2

# 无 API Key 时可用模拟模式跑通全流程（输出假译文，不产生费用）
LLM_MOCK=0
LLM_MOCK_DELAY=0.25

# ------------------------------------------------------------------ 切片与翻译
# 单段落最大字符数，超长段落会在句末切分
TRANSLATE_MAX_CHARS=1800
# 是否翻译参考文献条目（默认关闭，节省 token）
TRANSLATE_REFS=0
# 是否启用术语表约束
GLOSSARY_ENABLED=1
# 上传大小上限（MB）
MAX_UPLOAD_MB=80

# ------------------------------------------------------------------ 其它
DATA_DIR=./data
TZ=Asia/Shanghai

# ------------------------------------------------------------------ 语音合成（小米 MiMo TTS）
# 阅读器「朗读」功能：逐段合成中文译文并播放；留空则隐藏朗读按钮
TTS_API_KEY=
TTS_BASE_URL=https://api.xiaomimimo.com/v1
TTS_MODEL=mimo-v2.5-tts
# 内置音色：mimo_default / 冰糖 / 茉莉 / 苏打 / 白桦 / Mia / Chloe / Milo / Dean
TTS_VOICE=mimo_default
TTS_FORMAT=wav
TTS_TIMEOUT=180
