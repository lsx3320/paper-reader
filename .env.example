# ------------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# ------------------------------------------------------------------

# 对外端口
HOST_PORT=8000

# ------------------------------------------------------------------ 模型
# 任意 OpenAI 兼容接口均可：DeepSeek / OpenAI / Kimi / 硅基流动 / Ollama / vLLM
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 翻译任务建议用较高温度（DeepSeek 官方推荐 1.3）
LLM_TEMPERATURE=1.3
# 并发请求数：段落级并发，过高可能触发限流
LLM_CONCURRENCY=6
LLM_TIMEOUT=120
LLM_RETRIES=2

# 无 API Key 时可用模拟模式跑通全流程（输出假译文，不产生费用）
LLM_MOCK=0
LLM_MOCK_DELAY=0.25

# ------------------------------------------------------------------ 切片与翻译
# 单段落最大字符数，超长段落会在句末切分
TRANSLATE_MAX_CHARS=1800
# 是否翻译参考文献条目（默认关闭，节省 token）
TRANSLATE_REFS=0
# 是否启用术语表约束
GLOSSARY_ENABLED=1
# 上传大小上限（MB）
MAX_UPLOAD_MB=80

# ------------------------------------------------------------------ 其它
DATA_DIR=./data
TZ=Asia/Shanghai

# ------------------------------------------------------------------ 论文发现
# 书库页顶部推荐论文：让上面配置的 LLM 直接推荐，并写一段中文概括 + 原文链接。
# 关闭后卡片不显示。LLM_MOCK=1 时也能离线跑通。
#
# 注意：论文出自模型自己的知识，所以看不到它训练截止之后的论文，
# 同一批经典论文也会反复出现（代码里做了角度轮换和标题去重来缓解）。
# 想要「最新收录」得接真实的文献库，那是另一套东西。
PICK_ENABLED=1
# 一次让模型推荐几篇。批量比一篇篇要省 token，但太多会摊薄质量
PICK_BATCH=3
# 推荐任务的温度：要多样性，但太高模型会开始编造标题和链接
PICK_TEMPERATURE=0.9
# 池子上限与补充阈值：低于 MIN 时后台自动补到 MAX
PICK_POOL_MIN=3
PICK_POOL_MAX=8
# 后台巡检间隔（秒）：池子见底时自动补，平时空转
PICK_REFRESH_SEC=1800
# 改了推荐提示词后自动清空旧池子，否则改完看不到任何变化
PICK_PURGE_VERSIONS=1

# ------------------------------------------------------------------ 语音合成（小米 MiMo TTS）
# 阅读器「朗读」功能：逐段合成中文译文并播放；留空则隐藏朗读按钮
#
# ⚠️ 注意「限时免费」≠「零余额可用」：mimo-v2.5-tts 本身限时免费（单价 ¥0），
#    但计费系统上线后，账户余额 ≤ 0 会被网关拦在模型计价之前，免费模型照样返回
#    HTTP 402 Insufficient account balance。此时朗读全部失败、译文缓存为空。
#    处理：到 mimo.mi.com → 账户余额 领取免费额度或充值任意金额（TTS 免费，不会被扣）。
#    排查：GET /api/tts/probe 真打一次接口给准话；GET /api/health 看 tts.ready。
TTS_API_KEY=
TTS_BASE_URL=https://api.xiaomimimo.com/v1
TTS_MODEL=mimo-v2.5-tts
# 内置音色：mimo_default / 冰糖 / 茉莉 / 苏打 / 白桦 / Mia / Chloe / Milo / Dean
TTS_VOICE=mimo_default
TTS_FORMAT=wav
TTS_TIMEOUT=180
# 账户级故障（余额不足 / Key 失效）后的熔断冷却秒数：期间朗读直接返回明确原因，
# 不再逐段空打接口；设 0 关闭熔断（每次都真打接口）
TTS_FATAL_COOLDOWN=120
